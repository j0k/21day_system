# ---- Telegram ----
# Токен от @BotFather. Обязателен для запуска бота.
TELEGRAM_BOT_TOKEN=

# ---- LLM (OpenAI-совместимый API) — необязательно ----
# Без ключа бот работает в офлайн-режиме (совет по правилам, без сети).
#
# Можно задать ключ одним из имён — бот подхватит первое найденное:
#   OPENAI_API_KEY      — OpenAI напрямую (base_url по умолчанию api.openai.com)
#   ROUTERAI_API_KEY    — RouterAI (base_url по умолчанию routerai.ru/api/v1,
#                         модель с префиксом провайдера, напр. openai/gpt-4o-mini)
#   LLM_API_KEY         — любой другой OpenAI-совместимый сервис
#
# Работает и через .env, и через переменные окружения Windows:
#   [Environment]::SetEnvironmentVariable("ROUTERAI_API_KEY","КЛЮЧ","User")

OPENAI_API_KEY=
# ROUTERAI_API_KEY=
# LLM_API_KEY=

# Явное переопределение (обычно не нужно — подставляется по имени ключа).
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---- Администраторы (необязательно) ----
# Telegram user_id через запятую: доступ к /admin и /dev.
# ADMIN_IDS=52160369
